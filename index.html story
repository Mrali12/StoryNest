<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StoryNest — English &amp; Urdu Stories</title>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600;700&family=Noto+Nastaliq+Urdu:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{--ink:#14110F; --surface:#1E1A16; --border:#332C24; --gold:#C9A227; --maroon:#8A3324; --text:#EDE6DA; --text-dim:#A99E8C; --danger:#B4443A;}
  *{box-sizing:border-box; margin:0; padding:0;}
  body{color:var(--text); font-family:'Inter',sans-serif; background:var(--ink);}
.urdu{font-family:'Noto Nastaliq Urdu', serif; direction:rtl; line-height:2.1;}
  header{position:sticky; top:0; z-index:40; background:rgba(20,17,15,.92); border-bottom:1px solid var(--border);}
.header-inner{max-width:1100px; margin:0 auto; padding:14px 18px; display:flex; align-items:center; gap:16px; flex-wrap:wrap;}
.logo{font-size:1.5rem; font-weight:700; color:var(--paper);}.logo span{color:var(--gold);}
.search-wrap{flex:1; min-width:140px;}.search-wrap input{width:100%; background:var(--surface); border:1px solid var(--border); color:var(--text); padding:9px 14px; border-radius:8px;}
.header-actions{display:flex; gap:10px; margin-left:auto;}
.btn{border:1px solid var(--gold); background:transparent; color:var(--gold); padding:8px 16px; border-radius:8px; cursor:pointer;}
.btn-solid{background:var(--gold); color:var(--ink); border:1px solid var(--gold); padding:8px 16px; border-radius:8px; cursor:pointer;}
.hero{max-width:1100px; margin:0 auto; padding:56px 18px 28px; text-align:center;}.hero h1{font-family:'Lora',serif; font-size:2.4rem; color:var(--paper);}.hero h1 em{color:var(--gold);}
.chip-row{max-width:1100px; margin:0 auto; padding:0 18px 26px; display:flex; gap:10px; flex-wrap:wrap; justify-content:center;}
.chip{border:1px solid var(--border); background:var(--surface); color:var(--text-dim); padding:7px 15px; border-radius:20px; cursor:pointer;}
.chip.active{border-color:var(--gold); color:var(--gold);}
.grid-wrap{max-width:1100px; margin:0 auto; padding:0 18px 60px;}
.grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:22px;}
.card{background:var(--surface); border:1px solid var(--border); border-top:3px solid var(--maroon); border-radius:14px; overflow:hidden; cursor:pointer;}
.card:hover{border-top-color:var(--gold);}
.card-cover{aspect-ratio:3/4; position:relative;}.card-cover img{width:100%; height:100%; object-fit:cover;}
.lang-badge{position:absolute; top:8px; left:8px; background:rgba(20,17,15,.85); color:var(--gold); font-size:.68rem; font-weight:700; padding:3px 8px;}
.card-body{padding:14px;}.card-cat{color:var(--maroon); font-size:.72rem; font-weight:700;}.card-title{font-family:'Lora',serif; font-size:1.08rem; color:var(--paper); margin:5px 0;}
.games-section{max-width:1100px; margin:0 auto; padding:40px 18px 60px;}.games-section h2{font-family:'Lora',serif; color:var(--gold); font-size:1.7rem; text-align:center; margin-bottom:30px;}
.game-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:18px;}
.game-card{background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:26px 18px; text-align:center; cursor:pointer;}.game-card:hover{border-color:var(--gold);}
.game-card.icon{font-size:2.2rem; margin-bottom:10px;}.game-card h3{color:var(--gold); font-family:'Lora',serif;}
.overlay{position:fixed; inset:0; background:rgba(10,8,6,.72); z-index:100; display:none; align-items:center; justify-content:center; padding:30px 14px;}
.overlay.show{display:flex;}
.modal{background:var(--surface); border:1px solid var(--border); border-radius:14px; max-width:440px; width:100%; padding:28px 24px; position:relative;}
.modal h2{font-family:'Lora',serif; color:var(--paper); font-size:1.3rem; margin-bottom:18px;}
.field{margin-bottom:14px;}.field label{display:block; font-size:.82rem; color:var(--text-dim); margin-bottom:5px;}
.field input,.field select,.field textarea{width:100%; background:var(--ink); border:1px solid var(--border); color:var(--text); padding:9px 12px; border-radius:8px;}
.field input[type="file"]{padding:6px;}.field textarea{min-height:160px;}
.modal-close{position:absolute; top:10px; right:14px; background:none; border:none; color:var(--text-dim); font-size:1.5rem; cursor:pointer;}
.reader{background:var(--ink); max-width:720px; width:100%; min-height:100vh;}.reader-top{position:sticky; top:0; background:rgba(20,17,15,.95); border-bottom:1px solid var(--border); padding:14px 20px;}
.reader-body{padding:26px 24px 60px;}.reader-cover{width:100%; max-height:280px; object-fit:cover; margin-bottom:22px; border:1px solid var(--border);}
.reader-title{font-family:'Lora',serif; font-size:1.7rem; color:var(--paper);}.reader-content{font-size:1.05rem; color:var(--text); white-space:pre-wrap; line-height:1.85;}.reader-content.urdu{font-size:1.35rem;}
.reader-actions{display:flex; gap:10px; margin-top:34px; padding-top:22px; border-top:1px solid var(--border);}.icon-btn{background:var(--surface); border:1px solid var(--border); color:var(--text); padding:9px 16px; border-radius:8px; cursor:pointer;}
  #toast{position:fixed; bottom:22px; left:50%; transform:translateX(-50%); background:var(--paper); color:var(--ink); padding:11px 22px; border-radius:8px; font-weight:600; z-index:200; opacity:0; transition:opacity.25s;}
  #toast.show{opacity:1;}
  footer{border-top:1px solid var(--border); padding:34px 18px 24px; text-align:center; color:var(--text-dim);}
.img-preview{width:100%; max-height:150px; object-fit:cover; border-radius:8px; margin-top:8px; border:1px solid var(--border); display:none;}
  /* GAME CSS */
.memory-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin:15px 0;}
.memory-card{aspect-ratio:1; background:var(--ink); border:2px solid var(--border); border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:2rem; cursor:pointer;}
.memory-card.flipped{background:var(--gold); color:var(--ink);}
.tic-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:8px; max-width:300px; margin:15px auto;}
.tic-cell{aspect-ratio:1; background:var(--ink); border:2px solid var(--border); font-size:3rem; display:flex; align-items:center; justify-content:center; cursor:pointer; color:var(--gold);}
.snake-canvas{border:2px solid var(--gold); background:var(--ink); margin:10px 0;}.game-score{font-size:1.2rem; color:var(--gold); margin-bottom:15px;}
</style>
</head>
<body>

<header>
  <div class="header-inner">
    <div class="logo">📖Story<span>Nest</span></div>
    <div class="search-wrap"><input type="text" id="searchInput" placeholder="Search stories..."></div>
    <div class="header-actions"><button class="btn" id="addStoryBtn">+ Add Story</button></div> <!-- ID ADD KI -->
  </div>
</header>

<div class="hero"><h1>Stories that stay with you — <em>English & Urdu</em></h1></div>

<div class="chip-row" id="categoryChips">
  <button class="chip active" data-cat="All">All</button>
  <button class="chip" data-cat="Romance">Romance</button>
  <button class="chip" data-cat="Horror">Horror</button>
  <button class="chip" data-cat="Adventure">Adventure</button>
  <button class="chip" data-cat="Comedy">Comedy</button>
</div>

<div class="grid-wrap"><div class="grid" id="storyGrid">Loading...</div></div>

<div class="games-section">
  <h2>🎮 Mini Games</h2>
  <div class="game-grid" id="gamesGrid"></div>
</div>

<footer>© 2026 StoryNest. Made with ❤️</footer>

<div id="passwordModal" class="overlay"><div class="modal"><button class="modal-close" id="closePassBtn">&times;</button><h2>Admin Login</h2><div class="field"><label>Enter Password</label><input type="password" id="adminPass" placeholder="Killer9211"></div><button class="btn-solid" style="width:100%" id="loginBtn">Login</button><p id="passError" style="color:var(--danger); margin-top:10px; display:none;">Wrong Password!</p></div></div>

<div id="adminModal" class="overlay"><div class="modal"><button class="modal-close" id="closeAdminBtn">&times;</button><h2>Add New Story</h2><div class="field"><label>Story Title</label><input type="text" id="storyTitle"></div><div class="field"><label>Cover Image</label><input type="file" id="storyImageFile" accept="image/*"><img id="imgPreview" class="img-preview"></div><div class="field"><label>Category</label><select id="storyCategory"><option>Romance</option><option>Horror</option><option>Adventure</option><option>Comedy</option></select></div><div class="field"><label>Language</label><select id="storyLang"><option value="en">English</option><option value="ur">Urdu</option></select></div><div class="field"><label>Story Content</label><textarea id="storyContent"></textarea></div><button class="btn-solid" style="width:100%" id="publishBtn">Publish Story</button></div></div>

<div id="readerModal" class="overlay"><div class="reader"><div class="reader-top"><button class="btn" id="closeReaderBtn">← Back</button></div><div class="reader-body"><img id="rImage" class="reader-cover"><div class="card-cat" id="rCat"></div><h1 class="reader-title" id="rTitle"></h1><div class="reader-content" id="rContent"></div><div class="reader-actions"><button class="icon-btn" id="readAloudBtn">🔊 Read Aloud</button></div></div></div></div>

<div id="gameModal" class="overlay"><div class="modal" style="max-width:500px;"><button class="modal-close" id="closeGameBtn">&times;</button><div id="gameContent"></div></div></div>

<div id="toast"></div>

<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-storage-compat.js"></script>

<script>
const firebaseConfig = {
  apiKey: "YOUR_API_KEY",
  authDomain: "YOUR_AUTH_DOMAIN",
  projectId: "YOUR_PROJECT_ID",
  storageBucket: "YOUR_PROJECT_ID.appspot.com",
  appId: "YOUR_APP_ID"
};
firebase.initializeApp(firebaseConfig);
const db = firebase.firestore();
const storage = firebase.storage();

const ADMIN_PASSWORD = "Killer9211";
let stories = []; let selectedFile = null; let snakeInterval;

// SAB KUCH DOM LOAD HONE KE BAAD CHALEGA
document.addEventListener('DOMContentLoaded', function(){

  // BUTTON LISTENERS - YEHI FIX HAI
  document.getElementById('addStoryBtn').onclick = openAdmin;
  document.getElementById('closePassBtn').onclick = closePassModal;
  document.getElementById('loginBtn').onclick = checkPassword;
  document.getElementById('closeAdminBtn').onclick = closeAdmin;
  document.getElementById('publishBtn').onclick = addStory;
  document.getElementById('closeReaderBtn').onclick = closeReader;
  document.getElementById('closeGameBtn').onclick = closeGame;
  document.getElementById('readAloudBtn').onclick = readAloud;

  // IMAGE PREVIEW
  document.getElementById('storyImageFile').onchange = function(e){
    selectedFile = e.target.files[0];
    if(selectedFile){
      const reader = new FileReader();
      reader.onload = function(e){ document.getElementById('imgPreview').src = e.target.result; document.getElementById('imgPreview').style.display = 'block'; }
      reader.readAsDataURL(selectedFile);
    }
  }

  // LOAD GAMES
  const games = [ {id:1, icon:"🧠", title:"Memory Match"}, {id:2, icon:"🎯", title:"Number Guess"}, {id:3, icon:"⭕", title:"Tic Tac Toe"}, {id:4, icon:"🐍", title:"Snake Game"}, {id:5, icon:"✂️", title:"Rock Paper Scissors"} ];
  document.getElementById('gamesGrid').innerHTML = games.map(g=>`<div class="game-card" data-id="${g.id}"><div class="icon">${g.icon}</div><h3>${g.title}</h3></div>`).join('');

  // GAME CLICK LISTENER
  document.querySelectorAll('.game-card').forEach(card=>{
    card.onclick = ()=> playGame(parseInt(card.dataset.id));
  });

});

// PASSWORD
function openAdmin(){ document.getElementById('passwordModal').classList.add('show'); }
function closePassModal(){ document.getElementById('passwordModal').classList.remove('show'); document.getElementById('adminPass').value=''; document.getElementById('passError').style.display='none'; }
function checkPassword(){ if(document.getElementById('adminPass').value === ADMIN_PASSWORD){ closePassModal(); document.getElementById('adminModal').classList.add('show'); } else { document.getElementById('passError').style.display='block'; } }
function closeAdmin(){ document.getElementById('adminModal').classList.remove('show'); selectedFile=null; document.getElementById('imgPreview').style.display='none'; }

// ADD STORY
async function addStory(){
  const title = document.getElementById('storyTitle').value; const cat = document.getElementById('storyCategory').value; const lang = document.getElementById('storyLang').value; const content = document.getElementById('storyContent').value;
  if(!title ||!content){ showToast("Title aur Content zaroori hai"); return; }
  let imageUrl = "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=400";
  if(selectedFile){ const ref = storage.ref('story_covers/' + Date.now() + '_' + selectedFile.name); const snap = await ref.put(selectedFile); imageUrl = await snap.ref.getDownloadURL(); }
  await db.collection("stories").add({ title, image:imageUrl, cat, lang, content, createdAt: firebase.firestore.FieldValue.serverTimestamp() });
  closeAdmin(); showToast("Story Published!"); document.getElementById('storyTitle').value=''; document.getElementById('storyContent').value='';
}

// LOAD STORIES
db.collection("stories").orderBy("createdAt","desc").onSnapshot(snap=>{ stories = []; snap.forEach(doc=>stories.push({id:doc.id,...doc.data()})); filterStories(); });

function renderStories(list){
  const grid = document.getElementById('storyGrid');
  grid.innerHTML = list.map(s=>`<div class="card" onclick='openReader(${JSON.stringify(s).replace(/'/g,"&apos;")})'><div class="card-cover"><img src="${s.image || 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=400'}"><div class="lang-badge">${s.lang==='ur'?'UR':'EN'}</div></div><div class="card-body"><div class="card-cat">${s.cat}</div><div class="card-title">${s.title}</div></div></div>`).join('') || '<div style="grid-column:1/-1; text-align:center;">No stories yet</div>';
}

// SEARCH + FILTER
function filterStories(){
  const search = document.getElementById('searchInput').value.toLowerCase(); const cat = document.querySelector('.chip.active').dataset.cat;
  let filtered = stories; if(cat!== 'All') filtered = filtered.filter(s=>s.cat===cat); if(search) filtered = filtered.filter(s=>s.title.toLowerCase().includes(search));
  renderStories(filtered);
}
document.getElementById('searchInput').oninput = filterStories;
document.querySelectorAll('.chip').forEach(chip=>{ chip.onclick=()=>{ document.querySelectorAll('.chip').forEach(c=>c.classList.remove('active')); chip.classList.add('active'); filterStories(); } });

// READER
function openReader(s){ document.getElementById('rImage').src = s.image; document.getElementById('rCat').innerText = s.cat; document.getElementById('rTitle').innerText = s.title; document.getElementById('rContent').innerText = s.content; document.getElementById('rContent').className = 'reader-content ' + (s.lang==='ur'?'urdu':''); document.getElementById('readerModal').classList.add('show'); window.currentStory = s; }
function closeReader(){ document.getElementById('readerModal').classList.remove('show'); speechSynthesis.cancel(); }
function readAloud(){ if(speechSynthesis.speaking){ speechSynthesis.cancel(); document.getElementById('readAloudBtn').innerText='🔊 Read Aloud'; return; } let u=new SpeechSynthesisUtterance(window.currentStory.content); u.lang=window.currentStory.lang=='ur'?'ur-PK':'en-US'; document.getElementById('readAloudBtn').innerText='⏹️ Stop'; u.onend=()=>document.getElementById('readAloudBtn').innerText='🔊 Read Aloud'; speechSynthesis.speak(u); }

// GAMES
function playGame(id){ document.getElementById('gameModal').classList.add('show'); if(id===1) startMemory(); if(id===2) startGuess(); if(id===3) startTicTacToe(); if(id===4) startSnake(); if(id===5) startRPS(); }
function closeGame(){ document.getElementById('gameModal').classList.remove('show'); clearInterval(snakeInterval); document.removeEventListener('keydown', snakeKey); }

// 1. MEMORY MATCH
let memoryCards = ['🍎','🍎','🍌','🍌','🍇','🍇','🍊','🍊']; let flipped = [], matched=0;
function startMemory(){ memoryCards.sort(()=>0.5-Math.random()); flipped=[]; matched=0; document.getElementById('gameContent').innerHTML = `<h2>🧠 Memory Match</h2><div class="game-score">Matched: <span id="memScore">0</span>/4</div><div class="memory-grid">` + memoryCards.map((c,i)=>`<div class="memory-card" onclick="flipCard(${i})" id="card${i}">?</div>`).join('') + `</div>`; }
function flipCard(i){ const card = document.getElementById('card'+i); if(flipped.length<2 &&!card.classList.contains('flipped')){ card.innerText = memoryCards[i]; card.classList.add('flipped'); flipped.push({i,val:memoryCards[i]}); if(flipped.length==2){ setTimeout(checkMatch, 800); } } }
function checkMatch(){ if(flipped[0].val==flipped[1].val){ matched++; document.getElementById('memScore').innerText=matched; if(matched==4) setTimeout(()=>alert('You Won! 🎉'),300); } else{ document.getElementById('card'+flipped[0].i).innerText='?'; document.getElementById('card'+flipped[1].i).innerText='?'; document.getElementById('card'+flipped[0].i).classList.remove('flipped'); document.getElementById('card'+flipped[1].i).classList.remove('flipped'); } flipped=[]; }

// 2. NUMBER GUESS
let secretNumber = Math.floor(Math.random()*100)+1;
function startGuess(){ document.getElementById('gameContent').innerHTML = `<h2>🎯 Number Guess</h2><p>Guess 1 to 100</p><input type="number" id="guessInput"><button class="btn-solid" onclick="checkGuess()">Guess</button><p id="guessResult" style="margin-top:10px; color:var(--gold);"></p>`; }
function checkGuess(){ let val = parseInt(document.getElementById('guessInput').value); let res = document.getElementById('guessResult'); if(val==secretNumber){ res.innerText="Correct! You Won! 🎉"; secretNumber = Math.floor(Math.random()*100)+1; } else if(val<secretNumber){ res.innerText="Too Low! ⬆️"; } else{ res.innerText="Too High! ⬇️"; } }

// 3. TIC TAC TOE
let ticBoard = ['','',''], ticTurn='X';
function startTicTacToe(){ ticBoard = ['','','']; ticTurn='X'; document.getElementById('gameContent').innerHTML = `<h2>⭕ Tic Tac Toe</h2><p>Turn: <span id="ticTurn" style="color:var(--gold)">X</span></p><div class="tic-grid">` + Array(9).fill().map((_,i)=>`<div class="tic-cell" onclick="ticMove(${i})" id="tic${i}"></div>`).join('') + `</div>`; }
function ticMove(i){ if(ticBoard[i]==''){ ticBoard[i]=ticTurn; document.getElementById('tic'+i).innerText=ticTurn; if(checkTicWin()){ setTimeout(()=>alert(ticTurn+' Wins! 🎉'),200); } else if(!ticBoard.includes('')){ setTimeout(()=>alert('Draw!'),200); } else{ ticTurn = ticTurn=='X'?'O':'X'; document.getElementById('ticTurn').innerText=ticTurn; } } }
function checkTicWin(){ const wins = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]]; return wins.some(w=>ticBoard[w[0]]&&ticBoard[w[0]]==ticBoard[w[1]]&&ticBoard[w[0]]==ticBoard[w[2]]); }

// 4. SNAKE GAME
let snake=[{x:10,y:10}], food={x:15,y:15}, dir={x:1,y:0}, snakeScore=0;
function startSnake(){ snake=[{x:10,y:10}]; food={x:15,y:15}; dir={x:1,y:0}; snakeScore=0; document.getElementById('gameContent').innerHTML = `<h2>🐍 Snake Game</h2><div class="game-score">Score: <span id="snakeScore">0</span></div><canvas class="snake-canvas" id="snakeCanvas" width="300" height="300"></canvas><p>Use Arrow Keys</p>`; document.addEventListener('keydown', snakeKey); snakeInterval = setInterval(moveSnake, 150); }
function snakeKey(e){ if(e.key=='ArrowUp'&&dir.y==0)dir={x:0,y:-1}; if(e.key=='ArrowDown'&&dir.y==0)dir={x:0,y:1}; if(e.key=='ArrowLeft'&&dir.x==0)dir={x:-1,y:0}; if(e.key=='ArrowRight'&












